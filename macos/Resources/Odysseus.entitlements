<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      No App Sandbox: this app spawns a local server subprocess, that server
      spawns further subprocesses (built-in MCP servers, optionally
      tmux/llama.cpp for Cookbook), and talks to IMAP/SMTP/CalDAV — a much
      harder fit for the Sandbox than for a plain Developer ID build. See
      macos/README.md for the App Store distribution tradeoffs.

      com.apple.security.cs.allow-unsigned-executable-memory and
      disable-library-validation: PyInstaller-frozen Python apps commonly
      need both under Hardened Runtime, because compiled C-extension
      .so/.dylib files pulled in by dependencies (onnxruntime, numpy, etc.)
      aren't necessarily all signed with a matching Team ID, and some
      Python/JIT-adjacent runtime code needs unsigned executable pages. This
      is a known, documented pattern for shipping frozen Python apps signed
      for Developer ID distribution, not specific to this app's own code.
    -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
